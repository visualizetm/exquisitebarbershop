# Copy to .env for local development. Never commit .env.
# Secrets are server side only. Nothing secret may ever be placed in a VITE_ variable.

# --- Required now ---------------------------------------------------------------

# MongoDB connection string. Must point at a replica set (Atlas is one) because
# bookings are written inside multi-document transactions.
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0

# Database name. Keep separate names for production, preview and local.
MONGODB_DB_NAME=exquisite_dev

# Public base URL of the site, used to build the customer manage links in emails
# and to validate the Origin header on mutating requests. No trailing slash.
APP_BASE_URL=http://localhost:5173

# HMAC key that signs the customer cancel/reschedule links. At least 32 random
# characters. Rotating it invalidates every outstanding manage link.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MANAGE_LINK_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# --- Needed later (email delivery, prompt 2) --------------------------------------

# Which notification transport to use: "log" prints emails to the server log,
# "resend" sends them through Resend. Defaults to "log" outside production.
EMAIL_PROVIDER=log

# API key for the email provider. Only needed when EMAIL_PROVIDER is not "log".
# RESEND_API_KEY=

# Sender shown on customer confirmations and owner alerts.
# EMAIL_FROM="Exquisite Barber & Beauty Lounge <bookings@example.com>"

# --- Needed later (auth, prompt 3) -----------------------------------------------

# Password for the initial owner login created by the seed script. Read once by
# `npm run db:seed`; never stored anywhere in plain text.
# SEED_OWNER_PASSWORD=

# --- Needed later (scheduled jobs) -----------------------------------------------

# Shared secret that Vercel Cron sends as a bearer token to the outbox delivery
# endpoint. Any random string of at least 32 characters.
# CRON_SECRET=

# --- Optional -------------------------------------------------------------------

# Log verbosity: debug, info, warn or error. Defaults to info.
# LOG_LEVEL=info

# Only for machines that cannot download MongoDB binaries during tests. Points
# mongodb-memory-server at an existing mongod executable of the pinned version.
# MONGOMS_SYSTEM_BINARY=/path/to/mongod

# --- Provided by Vercel automatically (do not set by hand) ------------------------
# VERCEL_GIT_COMMIT_SHA  injected at build and runtime, rendered in the footer
# VERCEL_ENV             production | preview | development
# VERCEL_URL             deployment hostname, accepted as a valid Origin
