# Copy to .env for local development. Never commit .env.
# Secrets are server side only. Nothing secret may ever be placed in a VITE_ variable.

# --- Required now ---------------------------------------------------------------

# MongoDB connection string. Must point at a replica set (Atlas is one) because
# bookings are written inside multi-document transactions.
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0

# Database name. Keep separate names for production, preview and local.
MONGODB_DB_NAME=exquisite_dev

# Public base URL of the site, used to build the customer manage links in emails
# and to validate the Origin header on mutating requests. No trailing slash.
APP_BASE_URL=http://localhost:5173

# HMAC key that signs the customer cancel/reschedule links. At least 32 random
# characters. Rotating it invalidates every outstanding manage link.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MANAGE_LINK_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# Shared secret that Vercel Cron sends as a bearer token to the outbox delivery
# route (GET /api/internal/outbox/deliver). Any random string of at least 32
# characters. Required in production so the daily backstop can run.
CRON_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# --- Email delivery (production) ---------------------------------------------------

# Which notification transport to use: "log" prints emails to the server log,
# "resend" sends them through Resend. Defaults to "log".
EMAIL_PROVIDER=log

# API key for Resend. Required when EMAIL_PROVIDER is "resend".
# RESEND_API_KEY=

# Sender shown on customer confirmations and owner alerts. Required with Resend.
# EMAIL_FROM="Exquisite Barber & Beauty Lounge <bookings@example.com>"

# --- Seeding the owner login (needed now, seed time only) ---------------------------

# Password for the initial owner login created by `npm run db:seed` when no owner
# exists yet. At least 12 characters; weak passwords are refused. Read once and
# stored only as an argon2id hash. Remove it from the environment after seeding.
# SEED_OWNER_PASSWORD=

# Email for that owner login. Defaults to the placeholder in seed/shop.ts.
# SEED_OWNER_EMAIL=

# --- Photo storage ----------------------------------------------------------------

# "local" keeps uploads under .data/uploads and serves them from /uploads (dev and
# tests). "r2" uses Cloudflare R2 through presigned URLs and needs every R2_* value.
STORAGE_DRIVER=local

# Cloudflare R2: the account id, an API token with object read and write on the
# bucket, the bucket name, and the public base URL (a custom domain or r2.dev
# host) that serves the bucket. Required in production.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=https://photos.example.com

# --- Optional -------------------------------------------------------------------

# Log verbosity: debug, info, warn or error. Defaults to info.
# LOG_LEVEL=info

# Tests only: "off" stops emails from being delivered right after a response so
# a test can drive the outbox by hand. Leave unset everywhere else.
# OUTBOX_AFTER_RESPONSE=on

# Only for machines that cannot download MongoDB binaries during tests. Points
# mongodb-memory-server at an existing mongod executable of the pinned version.
# MONGOMS_SYSTEM_BINARY=/path/to/mongod

# --- Provided by Vercel automatically (do not set by hand) ------------------------
# VERCEL_GIT_COMMIT_SHA  injected at build and runtime, rendered in the footer
# VERCEL_ENV             production | preview | development
# VERCEL_URL             deployment hostname, accepted as a valid Origin
